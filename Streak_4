
import java.util.HashMap;

public class Main {
    public static void main(String[] args) {

        HashMap<String, Integer> marks = new HashMap<>();

        marks.put("Arun", 85);
        marks.put("Priya", 90);
        marks.put("Kumar", 75);

        // 1. size()
        System.out.println("Size: " + marks.size());

        // 2. keySet()
        System.out.println("Keys: " + marks.keySet());

        // 3. Iterate through keys
        for (String name : marks.keySet()) {
            System.out.println(name + " = " + marks.get(name));
        }

        // 4. Remove one key
        marks.remove("Kumar");

        System.out.println("Size after removal: " + marks.size());
    }
}

class Solution {
    public int mostFrequentElement(int[] nums) {
        if(nums.length == 0){
            return -1;
        }
        
        HashMap<Integer, Integer> map = new HashMap<>();
        int answer = nums[0];
        int maxFrequency = 0;
        for(int value : nums){
            int currentFrequency = map.getOrDefault(value, 0) + 1;
            map.put(value, currentFrequency);
            if(currentFrequency > maxFrequency || currentFrequency == maxFrequency && value < answer){
                maxFrequency = currentFrequency;
                answer = value;
            }
        

        
        }

        
       return answer;
    }
}

import java.util.*;

class Solution {

    // Returns the most frequent element in the array.
    public int mostFrequentElement(int[] arr) {

        // If the array is empty, there is no answer.
        if (arr.length == 0) {
            return -1;
        }

        int answer = arr[0];
        int maxFrequency = 0;

        // Check every element in the array.
        for (int i = 0; i < arr.length; i++) {
            int currentFrequency = 0;

            // Count the frequency of the current element.
            for (int j = 0; j < arr.length; j++) {

                // If both elements are equal, increment the frequency.
                if (arr[j] == arr[i]) {
                    currentFrequency++;
                }
            }

               /*
                    Update the answer if the current
                    element is a better candidate.
               */            
                if (currentFrequency > maxFrequency ||
                (currentFrequency == maxFrequency && arr[i] < answer)) {
                maxFrequency = currentFrequency;
                answer = arr[i];
            }
        }

        return answer;
    }
}

public class Main {

    // Driver Code starts
    public static void main(String[] args) {
        int[] arr = {4, 1, 4, 2, 1};

        Solution solution = new Solution();

        // Call the function to find the most frequent element.
        int answer = solution.mostFrequentElement(arr);

        System.out.println(answer);
    }
}


