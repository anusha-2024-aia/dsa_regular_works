public class SearchInsertPosition {
    public static int searchInsert(int[] nums, int target) {
        int left = 0;
        int right = nums.length - 1;

        while (left <= right) {
            // Prevents potential integer overflow compared to (left + right) / 2
            int mid = left + (right - left) / 2;

            if (nums[mid] == target) {
                return mid; // Target found, return its index
            } else if (nums[mid] < target) {
                left = mid + 1; // Search the right half
            } else {
                right = mid - 1; // Search the left half
            }
        }

        // If target is not found, left represents the correct insertion position
        return left;
    }

    public static void main(String[] args) {
        int[] nums = {1, 3, 5, 6};

        System.out.println(searchInsert(nums, 5)); // Output: 2 (Found at index 2)
        System.out.println(searchInsert(nums, 2)); // Output: 1 (Insert at index 1)
        System.out.println(searchInsert(nums, 7)); // Output: 4 (Insert at index 4)
        System.out.println(searchInsert(nums, 0)); // Output: 0 (Insert at index 0)
    }
}
