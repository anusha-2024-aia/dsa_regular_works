class Solution {
    public void rotate(int[] nums, int k) {
        int n = nums.length;
        k = k % n;

        reverse(nums, 0, k-1);
        reverse(nums, k, n-1);
        reverse(nums, 0, n-1);

        public void reverse(int[] nums, int left, int right){
            while(left < right){
                int temp = nums[left];
                nums[left] = nums[right];
                nums[right] = temp;
                left++;
                right--;
            }
        }
    }
}



import java.util.HashMap;
import java.util.Map;

class Solution {  
    public boolean anagramStrings(String s, String t) {
        if (s.length() != t.length()) {
            return false;
        }

        Map<Character, Integer> firstCounts = new HashMap<>();
        Map<Character, Integer> secondCounts = new HashMap<>();

        for (int i = 0; i < s.length(); i++) {
            char firstChar = s.charAt(i);
            char secondChar = t.charAt(i);

            firstCounts.put(firstChar, firstCounts.getOrDefault(firstChar, 0) + 1);
            secondCounts.put(secondChar, secondCounts.getOrDefault(secondChar, 0) + 1);
        }

        return firstCounts.equals(secondCounts);
    }
}


