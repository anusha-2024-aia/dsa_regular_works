class Solution {
    public void reverseString(List<Character> s) {
        //your code goes here
        int i=0; 
        int j = s.size()-1;
        while(i<j){
            Character temp = s.get(i);
            s.set(i,s.get(j));
            s.set(j,temp);
            i++;
            j--;
        }

        
    }
}