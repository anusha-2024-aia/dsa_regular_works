class Solution {
    public void reverseString(List<Character> s) {
        //your code goes here
        int i=0; 
        int j = s.size()-1;
        while(i<j){
            Character temp = s.get(i);
            s.set(i,s.get(j));
            s.set(j,temp);
            i++;
            j--;
        }

        
    }
}


class Solution {
    public boolean isSorted(int[] nums) {
        // Each value only needs to be checked against its previous one.
        for (int index = 1; index < nums.length; index++) {
            // A smaller current value breaks the non-decreasing order.
            if (nums[index] < nums[index - 1]) {
                return false;
            }
        }

        return true;
    }
}

public class Main {
    public static void main(String[] args) {
        int[] nums = {1, 2, 2, 4};

        Solution solution = new Solution();
        boolean answer = solution.isSorted(nums);

        System.out.println(answer);
    }
}