class Solution {
  public  int sum(int arr[], int n) {
    int sum = 0;
    for(int i=0; i<n; i++){
       
        sum += arr[i];
    }
    return sum;
      

    }
  
}



public class Main {

    static boolean f(int i, String s) {
        int n = s.length();

        if (i >= n / 2) {
            return true;
        }

        if (s.charAt(i) != s.charAt(n - i - 1)) {
            return false;
        }

        return f(i + 1, s);
    }

    public static void main(String[] args) {
        String s = "MADAM";

        System.out.println(f(0, s));
    }
}
